# AmiBuzz Server-side Cloud Functions Environment Configuration
# Copy this file to functions/.env for local emulator testing:
#   cp functions/.env.example functions/.env
#
# In production, set secrets via Firebase CLI:
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   etc.

# ---------------------------------------------------------------------------
# Google Gemini API
# Required for server-side AI sticker generation and prompt enhancement.
# Get your API key from Google AI Studio: https://aistudio.google.com/
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""

# ---------------------------------------------------------------------------
# Razorpay (India: UPI, Netbanking, Credit/Debit Cards, Wallets)
# Get credentials from Razorpay Dashboard -> Settings -> API Keys & Webhooks.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Stripe (International Card Payments)
# Get credentials from Stripe Dashboard -> Developers -> API keys & Webhooks.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# SendGrid (Email OTP Sign-In)
# When running with Firebase Functions emulator without credentials,
# the generated OTP is logged directly to the emulator console.
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""

# ---------------------------------------------------------------------------
# MSG91 (SMS OTP Sign-In)
# Required for sending SMS verification codes via DLT-approved flow templates.
# When running with Firebase Functions emulator without credentials,
# the generated OTP is logged directly to the emulator console.
# ---------------------------------------------------------------------------
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# ---------------------------------------------------------------------------
# Application Host URL
# Base URL used for payment success/cancel redirects and webhooks.
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"
